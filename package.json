{
  "name": "grant-fit-auditor",
  "version": "1.0.0",
  "description": "Grant Fit Auditor: use AI to apply to fewer grants, not more.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:ci": "npm run check && npm run test:e2e",
    "test:live:openai": "node scripts/liveReliabilitySuite.mjs",
    "check:forbidden": "node --test test/publicationFirewall.test.js",
    "check": "npm run check:forbidden && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "ajv": "^8.17.1",
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "openai": "^7.12.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
